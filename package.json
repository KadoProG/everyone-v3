{
  "name": "everyone-v3",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "check-types": "tsc --noEmit",
    "lint": "eslint --no-cache . --report-unused-disable-directives --max-warnings 0",
    "fix": "eslint --no-cache --fix . --report-unused-disable-directives --max-warnings 0",
    "lint:prettier": "prettier --check .",
    "fix:prettier": "prettier --write .",
    "format": "npm run fix:prettier && npm run fix",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@next/third-parties": "^16.3.8",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@reduxjs/toolkit": "^2.13.0",
    "marked": "^18.0.14",
    "next": "^16.3.8",
    "next-auth": "^4.24.15",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-links": "^10.6.1",
    "@storybook/addon-onboarding": "^10.6.1",
    "@storybook/nextjs": "^10.6.1",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.6.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "sass": "^1.105.1",
    "storybook": "^10.6.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "prisma": true,
    "esbuild": true,
    "unrs-resolver": true,
    "@parcel/watcher": false,
    "core-js-pure": false
  }
}
